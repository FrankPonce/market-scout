# All optional. With no keys the agent runs in offline demo mode (scripted LLM, real data tools).
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
# Enables the web_search tool (free tier at tavily.com)
TAVILY_API_KEY=
# Your repo URL; sent as contact info to data providers (Wikimedia requires one)
MARKETSCOUT_CONTACT=

# Optional: Extern course data server for the rug case study (keep the address private)
EXTERN_API_URL=
